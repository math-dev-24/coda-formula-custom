{
  "manifest_version": 3,
  "name": "Coda Formula Customizer",
  "version": "2.3.0",
  "description": "Customize the Coda formula editor: resize, reposition, change fonts, themes and documentation layout",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["*://*.coda.io/d/*", "*://*.grammarly.com/*"],
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Coda Formula Customizer"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y",
        "mac": "Alt+Shift+Y"
      },
      "description": "Open Coda Formula Customizer"
    },
    "apply-next-preset": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "Apply next saved Coda formula preset"
    },
    "toggle-documentation": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Show or hide Coda formula documentation"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.coda.io/d/*", "*://*.grammarly.com/*"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
